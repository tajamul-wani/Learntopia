rules_version = '2';

// Learntopia Firestore Security Rules
// Principle: deny everything by default; a signed-in user may only touch their OWN data.
// The Firebase web apiKey is public, so THESE RULES — not the key — protect the database.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---------------------------------------------------------

    // True only when the request is authenticated AND acting on its own uid.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // True when the request is from any authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // The owner/admin, identified by a custom claim ("admin": true) set on the
    // account via the Firebase Admin SDK. No email or PII appears in these rules
    // or in the client bundle — the claim is the sole source of admin authority.
    // This is the REAL access control behind the hidden admin portal.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Profile documents (Users/{uid}) may hold these known fields. Includes the
    // gamification fields (xp, quizPoints) and streak-popup/claim bookkeeping so
    // the XP/points/streak system can persist to the canonical profile doc.
    function isValidProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'fullName', 'displayName', 'avatarId', 'photoURL', 'usePhoto',
                               'totalPoints', 'streak', 'lastLoginDate',
                               'badges', 'xp', 'quizPoints', 'updatedAt',
                               'lastStreakClaimDate', 'lastStreakPopupDate'])
          && d.email is string
          && d.fullName is string
          && (!('displayName' in d) || d.displayName is string)
          && (!('avatarId' in d) || d.avatarId is string)
          // photoURL (the user's real/Google picture) lives ONLY on the private
          // profile — it is deliberately NOT allowed in isValidPublicEntry, so a
          // child's real face can never be written to the world-readable board.
          && (!('photoURL' in d) || d.photoURL is string)
          && (!('usePhoto' in d) || d.usePhoto is bool);
    }

    // Quiz attempts are validated so a client can't write garbage or an
    // impossible score. Shape mirrors Quiz.jsx -> saveScore(). The score is
    // bounded by the number of questions so a client can't claim more correct
    // answers than exist (anti-farming).
    function isValidAttempt() {
      let d = request.resource.data;
      return d.keys().hasOnly(['quizId', 'quizTitle', 'score', 'totalQuestions', 'xpEarned', 'completedAt'])
          && d.quizId is string
          && d.quizTitle is string
          && d.score is number
          && d.totalQuestions is number
          && d.totalQuestions > 0
          && d.score >= 0
          && d.score <= d.totalQuestions
          && (!('xpEarned' in d) || (d.xpEarned is number && d.xpEarned >= 0))
          && d.completedAt is timestamp;
    }

    // A course enrollment may only be flagged `completed: true` once the number
    // of completed modules covers every module. Any not-yet-completed write is
    // allowed (enroll, per-module progress). This gates completion on the
    // database, not just in the UI.
    function isValidEnrollment() {
      let d = request.resource.data;
      // Course-accuracy counters (for the Sharp Memory award) must be sane:
      // non-negative, and never more correct than answered.
      let statsOk = (!('correctTotal' in d) || (d.correctTotal is number && d.correctTotal >= 0))
          && (!('answeredTotal' in d) || (d.answeredTotal is number && d.answeredTotal >= 0))
          && d.get('correctTotal', 0) <= d.get('answeredTotal', 0);
      // Soft-unenroll flag + anti-farming XP markers must be the right shape.
      let flagsOk = (!('unenrolled' in d) || d.unenrolled is bool)
          && (!('xpAwardedModules' in d) || d.xpAwardedModules is list)
          && (!('courseXpAwarded' in d) || d.courseXpAwarded is bool);
      // Anti-farming integrity (updates only): the XP-awarded markers and the
      // accuracy counters can only GROW, so a tampered client can't wipe them to
      // re-earn XP by restarting a finished course.
      let antiTamperOk = resource == null || (
          d.get('xpAwardedModules', []).size() >= resource.data.get('xpAwardedModules', []).size()
          && (resource.data.get('courseXpAwarded', false) == false || d.get('courseXpAwarded', false) == true)
          && d.get('correctTotal', 0) >= resource.data.get('correctTotal', 0)
          && d.get('answeredTotal', 0) >= resource.data.get('answeredTotal', 0)
      );
      return statsOk && flagsOk && antiTamperOk
          && (d.get('completed', false) == false
              || (d.completedModules is list
                  && d.totalModules is number
                  && d.completedModules.size() >= d.totalModules));
    }

    // Per-quiz leaderboard rows carry DISPLAY data only, and are bounded the
    // same way quiz attempts are. Without this a client could post any score to
    // any quiz board, or write an email or real name into a collection every
    // signed-in user can read.
    function isValidQuizScore(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'displayName', 'avatarId', 'score', 'rawScore',
                               'totalQuestions', 'completedAt'])
          && d.userId == userId
          && d.totalQuestions is number && d.totalQuestions > 0 && d.totalQuestions <= 100
          && d.rawScore is number && d.rawScore >= 0 && d.rawScore <= d.totalQuestions
          && d.score is number && d.score >= 0
          && (!('displayName' in d) || d.displayName is string)
          && (!('avatarId' in d) || d.avatarId is string)
          // A board holds a personal best, so a row may only improve. A weaker
          // retake can never lower someone's standing, and a tampered client
          // cannot rewrite history downward either.
          && (resource == null || (d.score >= resource.data.get('score', 0)
                                   && d.rawScore >= resource.data.get('rawScore', 0)));
    }

    // Public leaderboard entries carry DISPLAY data only — never email/PII.
    // This shape check makes it impossible to write an email into the
    // world-readable PublicLeaderboard collection.
    function isValidPublicEntry() {
      let d = request.resource.data;
      // `fullName` is deliberately absent: it used to carry the account's real
      // name (a child's, for a Google sign-in) into a collection every signed-in
      // user can read. Writers clear any legacy value with deleteField().
      return d.keys().hasOnly(['uid', 'displayName', 'avatarId', 'totalPoints', 'streak', 'badges', 'xp', 'updatedAt'])
          && (!('displayName' in d) || d.displayName is string)
          && (!('avatarId' in d) || d.avatarId is string);
    }

    // Security check for profile updates (cheating prevention)
    function isValidProfileUpdate(userId) {
      let current = resource.data;
      let next = request.resource.data;

      // Prevent points cheating: totalPoints and xp may only increase or stay
      // the same. (The old fixed 200-per-write cap is removed — totalPoints is a
      // client-computed sum of XP + quiz points that legitimately jumps by more
      // than 200, e.g. course completion or a cross-device reconciliation.
      // Monotonic-increase still blocks a client from lowering another's score.)
      let currentPoints = current.get('totalPoints', 0);
      let nextPoints = next.get('totalPoints', 0);
      let currentXp = current.get('xp', 0);
      let nextXp = next.get('xp', 0);

      // Prevent badges cheating:
      // 1. Badges list may only grow (no deleting badges).
      // 2. Existing badges must not be modified or cleared.
      // 3. At most ONE badge added per write. Each award is its own write, so a
      //    single write can never inject a batch of forged badges. Note: rules
      //    can't verify an added badge was actually earned (badges are objects,
      //    not queryable, and some conditions live in subcollections / leaderboard
      //    rank). Badges are cosmetic and never affect XP/points/score, which stay
      //    monotonically guarded above. Full per-badge validation is tracked in
      //    LT-45 and would need a trusted backend (out of the free tier).
      let currentBadges = current.get('badges', []);
      let nextBadges = next.get('badges', []);

      return isValidProfile()
          && nextPoints >= currentPoints
          && nextXp >= currentXp
          && nextBadges.size() >= currentBadges.size()
          && nextBadges.size() <= currentBadges.size() + 1
          && (currentBadges.size() == 0 || nextBadges.hasAll(currentBadges));
    }

    // --- Account deletion ------------------------------------------------
    // Deleting an account must remove everything the user owns. The client
    // deletes in this order (src/services/accountDeletion.js):
    //   1. the profile and the public leaderboard entry, in one batch
    //   2. every remaining owned document (enrollments, quiz attempts, quiz
    //      leaderboard scores, private data)
    //   3. the Auth account
    // Step 2 documents are only deletable once the profile is gone. Outside
    // account deletion they stay non-deletable, so a user cannot delete an
    // enrollment or attempt to wipe its anti-farming markers and re-earn XP.
    function profileDeleted(userId) {
      return !existsAfter(/databases/$(database)/documents/Users/$(userId));
    }

    // --- User profile ----------------------------------------------------

    match /Users/{userId} {
      // Owner reads own profile; admin may read ALL profiles (backend access).
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidProfile();
      allow update: if isOwner(userId) && isValidProfileUpdate(userId);
      // Only as part of account deletion: the public leaderboard entry must be
      // gone after the same write, so a real name can't be left behind on it.
      allow delete: if isOwner(userId)
          && !existsAfter(/databases/$(database)/documents/PublicLeaderboard/$(userId));

      // --- Quiz attempts (append-only history) --------------------------
      // Owner can read and add attempts (admin may read any); nobody edits
      // past ones, which keeps the score record tamper-evident. Deletable by
      // the owner only during account deletion.
      match /quizAttempts/{attemptId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidAttempt();
        allow update: if false;
        allow delete: if isOwner(userId) && profileDeleted(userId);
      }

      // --- Enrolled courses + progress ------------------------------------
      // Owner-only writes (admin may read any). Enroll and per-module progress
      // writes are allowed; flagging completed requires all modules done.
      // Deletable by the owner only during account deletion.
      match /enrolledCourses/{courseId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) && profileDeleted(userId);
        allow create, update: if isOwner(userId) && isValidEnrollment();
      }

      // --- Gamification state (XP, badges, streak) ------------------------
      // Private, owner-only data behind the XP/level/badge UI. Holds no PII and
      // never feeds the leaderboard (that uses the validated totalPoints), so
      // owner read/write is sufficient. Without this match the subcollection
      // fell through to default-deny, silently blocking every XP/badge save.
      match /data/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Quiz Leaderboards -----------------------------------------------
    // Any authenticated user may read quiz leaderboards (needed for the
    // Leaderboard page). A user may only write their OWN score entry, and may
    // delete it only during account deletion.
    match /QuizLeaderboards/{quizId}/Scores/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidQuizScore(userId);
      allow delete: if isOwner(userId) && profileDeleted(userId);
    }

    // --- Public Leaderboard ----------------------------------------------
    // Any authenticated user may read (needed for the Global Leaderboard tab).
    // A user may only write/update their OWN entry, and the shape check ensures
    // NO email/PII is ever stored in this world-readable collection. Deleted
    // only together with the profile, during account deletion.
    match /PublicLeaderboard/{userId} {
      allow read: if isSignedIn();
      allow delete: if isOwner(userId) && profileDeleted(userId);
      allow create, update: if isOwner(userId) && isValidPublicEntry();
    }

    // --- Contact Messages ------------------------------------------------
    // Anyone (including unauthenticated visitors) may submit a contact form.
    // No client-side reads, updates, or deletes — messages are reviewed via
    // the Firebase Console only.
    function isValidContactMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'subject', 'message', 'submittedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.email is string && d.email.size() > 0 && d.email.size() <= 200
          && d.subject is string
          && d.message is string && d.message.size() >= 10 && d.message.size() <= 1000;
    }

    match /ContactMessages/{msgId} {
      allow create: if isValidContactMessage();
      allow read:   if isAdmin();          // admin reviews inquiries in-app
      allow update, delete: if false;
    }

    // --- Bug reports / system notes --------------------------------------
    // Admin-only: the owner logs and reviews technical notes from the portal.
    match /BugReports/{bugId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // --- Default deny ----------------------------------------------------
    // Anything not matched above is fully locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
